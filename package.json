{
  "name": "siteops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1 -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:audit": "node --import tsx lib/db/audit.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "dependencies": {
    "@posthog/next": "^0.4.97",
    "@serwist/next": "^9.5.7",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.50.2",
    "@types/web-push": "^3.6.4",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "next": "^16.2.9",
    "postgres": "^3.4.7",
    "posthog-js": "^1.205.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "web-push": "^3.6.7",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.0"
  }
}
