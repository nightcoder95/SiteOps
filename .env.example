# Supabase Auth + Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Postgres (runtime via transaction pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Postgres (migrations via direct connection)
DIRECT_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Next.js (client-visible)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: Web Push (PWA6). Generate with `npx web-push generate-vapid-keys`.
# Push opt-in stays hidden in the UI and sends no-op on the server until set.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@siteops.app

# Phase 2: Upstash Redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Automated backup (scripts/backup.ts, GitHub Actions) ---
# DATABASE_URL is already defined above; the backup reuses it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: folder name the backup creates/reuses in Drive (default: SiteOps-Backups)
# BACKUP_FOLDER_NAME=SiteOps-Backups
